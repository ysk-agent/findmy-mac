<?xml version="1.0" encoding="utf-8"?>
<!--
   Batch 3: defence in depth. The manifest sets allowBackup="false", so
   these rules are not consulted today; they exist so that, if backup is
   ever re-enabled, no app data - in particular the encrypted session
   store - is included. Every domain is excluded in full.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices on API 31 and above; see
   data_extraction_rules.xml for those.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
